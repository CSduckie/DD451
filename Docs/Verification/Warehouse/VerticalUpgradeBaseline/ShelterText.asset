--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f3cd9f8c424ac5439f636ad5435f100, type: 3}
  m_Name: ShelterText
  m_EditorClassIdentifier: MyPrecious.Localization::LocalizationTableSO
  entries:
  - key: shelter.title
    chinese: "\u5E87\u62A4\u6240"
    english: Shelter
  - key: shelter.free_upgrade
    chinese: "\u514D\u8D39\u5347\u7EA7"
    english: Upgrade for free
  - key: shelter.open_warehouse
    chinese: "\u6253\u5F00\u4ED3\u5E93"
    english: Open warehouse
  - key: shelter.ev
    chinese: "\u5F53\u524D EV\uFF1A{0} / \u95E8\u69DB {1}"
    english: 'Current EV: {0} / Required {1}'
  - key: shelter.current_size
    chinese: "\u5F53\u524D\u4ED3\u5E93\uFF1A{0} \xD7 {1}\uFF08{2}\u683C\uFF09"
    english: "Current: {0} \xD7 {1} ({2} cells)"
  - key: shelter.target_size
    chinese: "\u5347\u7EA7\u76EE\u6807\uFF1A{0} \xD7 {1}\uFF08{2}\u683C\uFF09"
    english: "Upgrade: {0} \xD7 {1} ({2} cells)"
  - key: shelter.explanation
    chinese: "\u624B\u52A8\u514D\u8D39\u6269\u5BB9\uFF0C\u4E0D\u6D88\u8017EV\u6216\u7269\u54C1\u3002\u6FC0\u6D3B\u540E\u672C\u6B21\u8FD0\u884C\u5185\u6C38\u4E45\u4FDD\u7559\u3002"
    english: Expand manually for free. No EV or items are spent. The upgrade lasts
      for this run.
  - key: shelter.upgraded
    chinese: "\u5347\u7EA7\u5B8C\u6210\uFF1A{0} \xD7 {1}\uFF08{2}\u683C\uFF09\u2192
      {3} \xD7 {4}\uFF08{5}\u683C\uFF09\u3002EV\u4E0D\u6D88\u8017\u3002"
    english: "Expanded: {0} \xD7 {1} ({2} cells) \u2192 {3} \xD7 {4} ({5} cells).
      No EV spent."
  - key: shelter.result.eligible
    chinese: "\u5DF2\u7B26\u5408\u514D\u8D39\u5347\u7EA7\u8D44\u683C"
    english: Eligible for the free upgrade
  - key: shelter.result.not_ready
    chinese: "\u5E87\u62A4\u6240\u6A21\u5757\u5C1A\u672A\u51C6\u5907\u597D"
    english: Shelter is not ready
  - key: shelter.result.not_in_shelter
    chinese: "\u5F53\u524D\u573A\u666F\u4E0D\u5141\u8BB8\u5E87\u62A4\u6240\u6574\u7406"
    english: Shelter management is unavailable here
  - key: shelter.result.already_activated
    chinese: "\u5DF2\u5347\u7EA7\uFF1BEV\u4E0B\u964D\u4E0D\u4F1A\u7F29\u4ED3"
    english: Already upgraded; lower EV will not shrink storage
  - key: shelter.result.insufficient_ev
    chinese: "EV\u4E0D\u8DB3"
    english: Not enough EV
  - key: shelter.result.invalid_configuration
    chinese: "\u5347\u7EA7\u914D\u7F6E\u65E0\u6548\uFF1A\u4E24\u8F74\u4E0D\u80FD\u7F29\u5C0F\uFF0C\u81F3\u5C11\u4E00\u8F74\u589E\u5927"
    english: 'Invalid upgrade: neither dimension may shrink; at least one must grow'
  - key: shelter.result.busy
    chinese: "\u8BF7\u5148\u7ED3\u675F\u62D6\u62FD\u6216\u9057\u5F03\u786E\u8BA4"
    english: Finish the drag or abandonment confirmation first
  - key: shelter.test_note
    chinese: "05\u9A8C\u8BC1\u573A\u666F\uFF5C\u5E03\u5A03\u5A03\u5DF2\u5165\u4ED3\uFF0C\u5DF2\u4FDD\u6709\u533B\u7597\u5305\u4ECD\u5728\u80CC\u5305\uFF08\u4EC501\u6570\u636E\uFF09\u3002\u521D\u59CBEV=7\uFF1B\u771F\u5B9E\u8F6C\u79FB\u4E0E\u64A4\u79BB\u6D41\u7A0B\u5F8506/08\u63A5\u5165\u3002"
    english: 05 test scene | Doll is stored; retained medkit stays in backpack (01
      data only). Initial EV = 7. Real transfers and extraction await 06/08.
