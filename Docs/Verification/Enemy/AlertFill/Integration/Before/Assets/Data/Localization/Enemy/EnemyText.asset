%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f3cd9f8c424ac5439f636ad5435f100, type: 3}
  m_Name: EnemyText
  m_EditorClassIdentifier: MyPrecious.Localization::LocalizationTableSO
  entries:
  - key: enemy.test.title
    chinese: "009 \u65E0\u4EBA\u673A\u4E0E\u6F5C\u884C \xB7 \u72EC\u7ACB\u6D4B\u8BD5"
    english: 009 Drone and stealth - isolated test
  - key: enemy.test.status
    chinese: "\u654C\u4EBA\u6D4B\u8BD5\u8F6E\u6B21 {0}  |  \u751F\u547D {1}/{2} 
      |  {3}  |  \u80CC\u5305{4}"
    english: Enemy test round {0}  |  HP {1}/{2}  |  {3}  |  Backpack {4}
  - key: enemy.test.drone_status
    chinese: "  |  \u65E0\u4EBA\u673A{0}\uFF1A{1}"
    english: '  |  Drone {0}: {1}'
  - key: enemy.test.instructions
    chinese: "A/D \u79FB\u52A8 \xB7 \u7A7A\u683C\u8DF3\u8DC3 \xB7 C \u8E72\u4F0F
      \xB7 Tab \u80CC\u5305 \xB7 \u7BB1\u65C1 E \u641C\u7D22 \xB7 F10 \u4E2D\u82F1\u5207\u6362\n\u9EC4\u8272\u77EE\u6321\u677F\u662F\u8E72\u4F0F\u63A9\u4F53\uFF1B\u5B9E\u5899\u72EC\u7ACB\u906E\u6321\u3002\u53F3\u4FA7\u4E24\u5757\u63A9\u4F53\u91CD\u53E0\uFF1B\u6B7B\u4EA1\u540E\u91CD\u65B0\u8FD0\u884C\u672C\u573A\u666F\u3002"
    english: 'A/D move - Space jump - C crouch - Tab backpack - E near box to search
      - F10 language

      Yellow low barriers hide crouching players; the solid
      wall blocks sight separately. Two covers overlap on the right. Restart Play
      after death.'
  - key: enemy.test.ready
    chinese: "\u4F7F\u7528\u771F\u5B9E\u80CC\u5305\u4E0E\u641C\u7D22\uFF1B\u5F00\u5305\u65F6\u4E16\u754C\u7EE7\u7EED\u8FD0\u884C\u3002\u654C\u4EBA\u8F6E\u6B21\u6309\u94AE\u4E0D\u56DE\u8840\u3001\u4E0D\u7ED3\u7B97\u6216\u5237\u65B0\u7269\u54C1\u3002"
    english: Real backpack and search; the world keeps running while open. Enemy
      round buttons do not heal, settle or refresh items.
  - key: enemy.test.next_round
    chinese: "\u4E0B\u4E00\u654C\u4EBA\u6D4B\u8BD5\u8F6E\u6B21"
    english: Next enemy test round
  - key: enemy.test.same_round
    chinese: "\u91CD\u590D\u521D\u59CB\u5316\u672C\u654C\u4EBA\u8F6E\u6B21"
    english: Repeat current enemy round
  - key: enemy.test.next_round_done
    chinese: "\u5DF2\u8C03\u7528\u6B63\u5F0F BeginRound\uFF1A\u4EC5\u654C\u4EBA\u6062\u590D\u3002\u751F\u547D\u3001\u80CC\u5305\u3001\u7BB1\u5B50\u4FDD\u6301\u539F\u6837\u3002"
    english: 'Called BeginRound: only enemies reset. Health, backpack and box remain
      unchanged.'
  - key: enemy.test.same_round_done
    chinese: "\u5DF2\u518D\u6B21\u8C03\u7528\u540C\u8F6E BeginRound\uFF1B\u5DF2\u81EA\u7206\u65E0\u4EBA\u673A\u5E94\u4FDD\u6301\u81EA\u7206\u3002"
    english: Called BeginRound with the same round. Exploded drones must remain exploded.
  - key: enemy.test.failed
    chinese: "\u6D4B\u8BD5\u521D\u59CB\u5316\u5931\u8D25\uFF0C\u8BF7\u67E5\u770B
      Console\uFF1B\u672A\u628A\u5931\u8D25\u5F53\u6210\u73A9\u6CD5\u901A\u8FC7\u3002"
    english: Test setup failed. Check Console; this is not a gameplay pass.
  - key: enemy.test.crouching
    chinese: "\u8E72\u4F0F"
    english: Crouching
  - key: enemy.test.standing
    chinese: "\u7AD9\u7ACB"
    english: Standing
  - key: enemy.test.open
    chinese: "\u6253\u5F00"
    english: open
  - key: enemy.test.closed
    chinese: "\u5173\u95ED"
    english: closed
  - key: enemy.state.none
    chinese: "\u672A\u8FD0\u884C"
    english: Inactive
  - key: enemy.state.patrol
    chinese: "\u5DE1\u903B"
    english: Patrol
  - key: enemy.state.chase
    chinese: "\u8FFD\u51FB"
    english: Chase
  - key: enemy.state.search
    chinese: "\u641C\u7D22"
    english: Search
  - key: enemy.state.explode
    chinese: "\u5DF2\u81EA\u7206"
    english: Exploded
